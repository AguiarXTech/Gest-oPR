# Copie para .env.local. Valores do projeto de DESENVOLVIMENTO no Supabase Cloud
# (painel → Project Settings → API). Nunca use aqui as chaves de produção.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto-dev>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE SERVIDOR — nunca use prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Ref do projeto gestao-frota-dev: trava db:reset, db:test e dev:users nele
SUPABASE_DEV_PROJECT_REF=

# Relatório de abastecimento (Abastecimentos › Relatório): planilha do Google
# Link CSV da planilha (Arquivo → Compartilhar → Publicar na Web → CSV, ou
# https://docs.google.com/spreadsheets/d/<ID>/export?format=csv com link de leitura)
RELATORIO_PLANILHA_CSV_URL=
# Link para abrir a planilha (botão "Abrir planilha"; opcional)
RELATORIO_PLANILHA_URL_EDICAO=
# Segredo do gatilho da planilha (Apps Script → POST /api/relatorio/atualizar)
RELATORIO_SEGREDO=
