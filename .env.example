# Copie para .env.local. Valores do projeto de DESENVOLVIMENTO no Supabase Cloud
# (painel → Project Settings → API). Nunca use aqui as chaves de produção.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto-dev>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE SERVIDOR — nunca use prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Ref do projeto gestao-frota-dev: trava db:reset, db:test e dev:users nele
SUPABASE_DEV_PROJECT_REF=
